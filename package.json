{
  "name": "htco-root",
  "version": "1.0.0",
  "private": true,
  "description": "HTCO Employee GPS Attendance & Project Task Management System Root",
  "scripts": {
    "postinstall": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run build:backend && npm run build:frontend",
    "seed:demo": "npm --prefix backend run seed:demo",
    "seed:demo:reset": "npm --prefix backend run seed:demo:reset",
    "vercel-build": "npm run build:frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "mysql2": "^3.24.5"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.6"
  }
}
